# Aplicacao
APP_NAME=TaskNote
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Seguranca - substitua por uma chave aleatoria longa fora do desenvolvimento
SECRET_KEY=troque-por-uma-chave-segura-com-pelo-menos-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Banco (valor usado pelo Docker Compose)
DATABASE_URL=postgresql+psycopg://tasknote:tasknote@db:5432/tasknote

# API
PAGINATION_DEFAULT_SIZE=20
PAGINATION_MAX_SIZE=100
# Lista JSON. Inclua o GitHub Pages ao publicar a API.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL no Docker Compose
POSTGRES_DB=tasknote
POSTGRES_USER=tasknote
POSTGRES_PASSWORD=tasknote
